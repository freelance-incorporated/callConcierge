generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  QUEUING  
  QUEUED   
  PROCESSING
  FAILED   
  SUCCEEDED
}

model Task {
  id             String     @id @default(uuid())
  userPhone      String     
  userName       String?    // ? means optional
  recipientPhone String     
  recipientName  String?
  instruction    String     
  userData       Json?  
  status         TaskStatus @default(QUEUING)
  result         Json? // final outcome for the call-task
  failureReason  String? // reason for failure, if any
  createdAt      DateTime   @default(now())
  startedAt      DateTime?  // when did python worker start processing the task
  completedAt    DateTime?  //when did " " complete the task
  updatedAt      DateTime   @updatedAt
}