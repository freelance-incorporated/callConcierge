generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  QUEUING
  QUEUED
  PROCESSING
  FAILED
  SUCCEEDED
}

enum CallAttemptStatus {
  CREATED
  DIALING
  RINGING
  CONNECTED
  COMPLETED
  NO_ANSWER
  BUSY
  REJECTED
  FAILED
}

model Task {
  id             String     @id @default(uuid())
  userPhone      String
  userName       String?
  recipientPhone String
  recipientName  String?
  instruction    String
  userData       Json?
  status         TaskStatus @default(QUEUING)
  result         Json?
  failureReason  String?
  createdAt      DateTime   @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  updatedAt      DateTime   @updatedAt

  callAttempts   CallAttempt[]
}

model CallAttempt {
  id             String            @id @default(uuid())
  task           Task             @relation(fields: [taskId], references: [id])
  taskId         String

  attemptNumber  Int               @default(1)
  status         CallAttemptStatus @default(CREATED)

  providerCallId String
  provider       String

  startedAt      DateTime?
  answeredAt     DateTime?
  endedAt        DateTime?
  duration       Int?//in seconds
  

  failureReason  String?

  transcript     String?
  recordingUrl   String?

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([provider, providerCallId])//prevents overlapping call ids across different providers.
  @@unique([taskId, attemptNumber])//prevents a task having multiple records for same number of attempts
}